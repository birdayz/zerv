load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_zig//zig:defs.bzl", "zig_binary")
load("//bazel:defs.bzl", "zerv_vk_binary")

zerv_vk_binary(
    name = "zerv-model-capture",
    main = "model_capture.zig",
    deps = ["//src:zerv_lib"],
)

zig_binary(
    name = "zerv-inspect",
    main = "inspect.zig",
    deps = ["//src:zerv_lib"],
)

exports_files(glob(["*.py"], exclude = ["check_generated.py"]), visibility = ["//tests:__pkg__"])

# The generated-files check (bazel/shaders.bzl), used by every package with generated files.
exports_files(["check_generated.py"], visibility = ["//visibility:public"])

# The SPIR-V compile scripts (bazel/shaders.bzl runs them), each with its GLSL sources.
py_library(
    name = "compile_matvec_lib",
    srcs = ["compile_matvec.py"],
    imports = ["."],
    data = ["//src/matvec:glsl"],
)

py_binary(
    name = "compile_matvec",
    srcs = ["compile_matvec.py"],
    deps = [":compile_matvec_lib"],
    visibility = ["//src:__subpackages__"],
)

py_binary(
    name = "compile_model",
    srcs = ["compile_model.py"],
    data = ["//src/model:glsl"],
    deps = [":compile_matvec_lib"],
    visibility = ["//src:__subpackages__"],
)

# Every Python script (//tests:test_build_lists checks how they build).
filegroup(
    name = "py_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//tests:__pkg__"],
)

# Every Zig source of this package (the format check, //:zig_fmt).
filegroup(
    name = "zig_srcs",
    srcs = glob(["*.zig"]),
    visibility = ["//:__pkg__"],
)
