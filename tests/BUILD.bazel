# Generated Vulkan fixtures (docs/specs/hermetic-build.md): the C ABI of the scoped Vulkan API
# and of the timestamp queries as the hermetic C compiler sees the pinned headers
# (@vulkan_headers), and the diagnostic shader compiled by the source-built glslc. Committed
# in fixtures/gpu/; vulkan_fixtures_test checks them, `bazel run //tests:vulkan_fixtures_update`
# rewrites them.
# The scoped Vulkan API inventory (tests/reference/vulkan_api.py): the ABI fixture here and
# zerv's bindings (//src/gpu:vk_zig, tools/generate_vulkan_bindings.py).
py_library(
    name = "vulkan_api",
    srcs = ["reference/vulkan_api.py"],
    imports = ["reference"],
    visibility = ["//tools:__pkg__"],
)

py_binary(
    name = "generate_vulkan_abi",
    srcs = [
        "reference/generate_vulkan_abi.py",
        "reference/vulkan_api.py",
    ],
    imports = ["reference"],
)

py_binary(
    name = "generate_gpu_timing_abi",
    srcs = ["reference/generate_gpu_timing_abi.py"],
)

genrule(
    name = "vulkan_abi_c",
    srcs = ["@vulkan_headers//:registry/vk.xml"],
    outs = ["vulkan_abi/abi.c"],
    cmd = "$(execpath :generate_vulkan_abi) source $(location @vulkan_headers//:registry/vk.xml) $@",
    tools = [":generate_vulkan_abi"],
)

genrule(
    name = "timing_abi_c",
    outs = ["vulkan_abi/timing_abi.c"],
    cmd = "$(execpath :generate_gpu_timing_abi) source $@",
    tools = [":generate_gpu_timing_abi"],
)

[
    (
        cc_binary(
            name = name + "_probe",
            srcs = [":" + name + "_c"],
            copts = [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-Werror",
            ],
            deps = ["@vulkan_headers"],
        ),
        genrule(
            name = name + "_probe_json",
            outs = ["vulkan_abi/%s.probe.json" % name],
            cmd = "$(execpath :%s_probe) > $@" % name,
            tools = [":" + name + "_probe"],
        ),
    )
    for name in [
        "vulkan_abi",
        "timing_abi",
    ]
]

genrule(
    name = "vulkan_fixtures",
    srcs = [
        "@vulkan_headers//:registry/vk.xml",
        "@vulkan_headers//:include/vulkan/vulkan_core.h",
        "fixtures/gpu/affine.comp",
        ":vulkan_abi_c",
        ":vulkan_abi_probe_json",
        ":timing_abi_c",
        ":timing_abi_probe_json",
    ],
    outs = [
        "vulkan_fixtures/abi.json",
        "vulkan_fixtures/affine.spv",
        "vulkan_fixtures/timing-abi.json",
    ],
    cmd = """
set -e
xml=$(location @vulkan_headers//:registry/vk.xml)
header=$(location @vulkan_headers//:include/vulkan/vulkan_core.h)
$(execpath :generate_vulkan_abi) record $$xml $$header $(location :vulkan_abi_c) $(location :vulkan_abi_probe_json) $(location vulkan_fixtures/abi.json)
$(execpath :generate_gpu_timing_abi) record $$header $(location :timing_abi_c) $(location :timing_abi_probe_json) $(location vulkan_fixtures/timing-abi.json)
$(execpath @shaderc//:glslc) --target-env=vulkan1.1 -O $(location fixtures/gpu/affine.comp) -o $(location vulkan_fixtures/affine.spv)
$(execpath @spirv_tools//:spirv-val) --target-env vulkan1.1 $(location vulkan_fixtures/affine.spv)
""",
    tools = [
        ":generate_gpu_timing_abi",
        ":generate_vulkan_abi",
        "@shaderc//:glslc",
        "@spirv_tools//:spirv-val",
    ],
)

