# Real-device Vulkan tests: one serial binary (the device is shared), run only when asked for,
# in both modes, and the shader spill gate (docs/bench/2026-09-24-aco-lds-spill.md) over the
# ReleaseFast run:
#   bazel test //tests:gpu //tests:gpu_release_fast //tests:gpu_spills
GPU_TAGS = ["manual", "exclusive", "gpu"]

# The test-only GPU runtime (docs/specs/hermetic-build.md, phase 4): the source-built Vulkan
# loader and Mesa RADV with an ICD manifest naming the driver relative to itself. GPU_ENV
# selects it for a test and its child processes (paths relative to the runfiles root, where
# tests start): nothing of the host's Vulkan stack is loaded. The loader searches no host
# directory (bazel/third_party/vulkan_loader.BUILD), layers are disabled.
genrule(
    name = "gpu_runtime",
    srcs = [
        "@libdrm//:data/amdgpu.ids",
        "@mesa//:radv",
        "@vulkan_loader//:libvulkan",
    ],
    outs = [
        "gpu_runtime/amdgpu.ids",
        "gpu_runtime/libvulkan.so.1",
        "gpu_runtime/libvulkan_radeon.so",
        "gpu_runtime/radeon_icd.json",
    ],
    cmd = """
for f in $(SRCS); do
  case $$f in
    */libvulkan.so.1|*/libvulkan_radeon.so|*/amdgpu.ids) cp $$f $(RULEDIR)/gpu_runtime/ ;;
  esac
done
printf '{"file_format_version": "1.0.1", "ICD": {"library_path": "./libvulkan_radeon.so", "api_version": "1.4.354", "library_arch": "64"}}\\n' > $(RULEDIR)/gpu_runtime/radeon_icd.json
""",
    tags = ["manual"],
)

GPU_RUNTIME = [":gpu_runtime"]

GPU_ENV = {
    "LD_LIBRARY_PATH": "tests/gpu_runtime",
    "VK_DRIVER_FILES": "tests/gpu_runtime/radeon_icd.json",
    "VK_LOADER_LAYERS_DISABLE": "~all~",
    # libdrm's device-name table (RADV reports "AMD Radeon RX 7900 XTX" from it).
    "AMDGPU_ASIC_ID_TABLE_PATHS": "tests/gpu_runtime",
    # The GPU tests check that the driver loaded is this runtime's (tests/gpu_gemm_f16.zig:
    # the device's pipeline key must be the one of src/model/native/test_radv/).
    "ZERV_TEST_GPU_RUNTIME": "test_radv",
}

