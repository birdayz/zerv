# External test oracles (docs/specs/hermetic-build.md, phase 3): the reference programs of
# tests/reference, built against the source-built ggml and llama.cpp. They are never part of
# zerv; built on request (manual, tag oracle; tools/zerv_build.py builds them for harnesses).
ORACLE_TAGS = [
    "manual",
    "oracle",
]

# llama.cpp's raw token pieces (tokenizer goldens; docs/research/tokenizer-bpe.md).
cc_binary(
    name = "oracle_tokenizer_pieces",
    srcs = ["reference/tokenizer_pieces.c"],
    copts = ["-std=c11"],
    tags = ORACLE_TAGS,
    deps = ["@llama_cpp//:llama"],
)

# libllama tokenizer benchmark (bench/run_tokenizer_matched.py).
cc_binary(
    name = "oracle_tokenizer_bench",
    srcs = ["reference/tokenizer_bench.c"],
    copts = [
        "-std=c11",
        "-O3",
        "-march=native",
    ],
    tags = ORACLE_TAGS,
    deps = ["@llama_cpp//:llama"],
)

# ggml row decoders over the real model (bench/run_model_quant.py).
cc_binary(
    name = "oracle_model_quant_bench",
    srcs = ["reference/model_quant_bench.c"],
    copts = [
        "-std=c11",
        "-O3",
        "-march=native",
    ],
    tags = ORACLE_TAGS,
    deps = [
        "@boringssl//:crypto",
        "@ggml//:ggml_base",
    ],
)

# The Qwen3.8 model oracle and batch capture (tests/reference/generate_model_oracle.py,
# tools/kv_quality.py, tools/prefill_quality.py): llama.cpp with ggml's Vulkan backend,
# registered statically (no backend is loaded from the file system).
[
    cc_binary(
        name = name,
        srcs = ["reference/%s.c" % source],
        copts = [
            "-std=c11",
            "-O2",
            "-Wall",
            "-Wextra",
            "-Werror",
        ],
        linkopts = ["-lm"],
        tags = ORACLE_TAGS,
        deps = ["@llama_cpp//:llama_vulkan"],
    )
    for name, source in [
        ("oracle_model", "model_oracle"),
        ("oracle_llama_batch_capture", "llama_batch_capture"),
    ]
]

# Independent C Vulkan transfer/dispatch program (tests/reference/generate_vulkan_goldens.py,
# bench/run_gpu_driver.py): SHA-256 from the source-built BoringSSL; the Vulkan loader chosen at
# run time (linked against the stub, like the Zig executables). -march=native as zerv's release
# build (the harness times it against zerv).
cc_binary(
    name = "oracle_vulkan_driver",
    srcs = ["reference/vulkan_driver.c"],
    additional_linker_inputs = ["//src/gpu:vulkan"],
    copts = [
        "-std=c11",
        "-O3",
        "-march=native",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["$(location //src/gpu:vulkan)"],
    tags = ORACLE_TAGS,
    deps = [
        "@boringssl//:crypto",
        "@vulkan_headers",
    ],
)

# ggml-vulkan matvec reference (tests/reference/generate_gpu_matvec.py, bench/run_gpu_matvec.py).
cc_binary(
    name = "oracle_gpu_matvec",
    srcs = ["reference/gpu_matvec.c"],
    copts = [
        "-std=c11",
        "-O3",
        "-fno-fast-math",
        "-ffp-contract=off",
    ],
    linkopts = ["-lm"],
    tags = ORACLE_TAGS,
    deps = ["@ggml//:ggml_vulkan_all"],
)
