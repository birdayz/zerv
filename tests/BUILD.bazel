# Real-device Vulkan tests: one serial binary (the device is shared), run only when asked for,
# in both modes, and the shader spill gate (docs/bench/2026-09-24-aco-lds-spill.md) over the
# ReleaseFast run:
#   bazel test //tests:gpu //tests:gpu_release_fast //tests:gpu_spills
GPU_TAGS = ["manual", "exclusive", "gpu"]

zig_test(
    name = "gpu",
    main = "gpu.zig",
    srcs = [
        "gpu_coopmat.zig",
        "gpu_gemm_f16.zig",
        "gpu_timing.zig",
        "gpu_workload.zig",
        "matvec_gpu.zig",
        "matvec_workload.zig",
        "model_gpu.zig",
    ],
    extra_srcs = [
        "fixtures/gpu/affine.spv",
        "fixtures/gpu/coopmat.spv",
        "fixtures/gpu/dispatch.json",
        "fixtures/gpu/matvec.json",
        "fixtures/gpu/timing-abi.json",
        "//src/gpu:vulkan",
    ],
    # Opened at run time by matvec_gpu.zig; the Vulkan stub is named on the link line.
    data = [
        "//src/matvec:shaders/f32_small.spv",
        "//src/gpu:vulkan",
    ],
    linkopts = ["$(location //src/gpu:vulkan)"],
    zigopts = ["-lc"],
    deps = ["//src:zerv_lib", "//src/gpu", "//src/matvec"],
    size = "large",
    tags = GPU_TAGS,
)

zig_configure_test(
    name = "gpu_release_fast",
    actual = ":gpu",
    mode = "release_fast",
    zigopt = ["-mcpu=native", "-fstrip"],
    size = "large",
    tags = GPU_TAGS + ["release_fast"],
)

# Fails when a pipeline the ReleaseFast GPU tests create spills VGPRs into LDS; the RADV
# statistics are an undeclared output (bazel-testlogs/tests/gpu_spills/test.outputs).
py_test(
    name = "gpu_spills",
    srcs = ["//tools:check_shader_spills.py"],
    main = "//tools:check_shader_spills.py",
    args = ["--", "$(rootpath :gpu_release_fast)"],
    data = [":gpu_release_fast"],
    size = "large",
    tags = GPU_TAGS,
)

# GPU workload helpers, also modules of the GPU benchmarks (//bench).
zig_library(
