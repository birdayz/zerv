#version 450
#extension GL_EXT_control_flow_attributes : require
// Four-byte packed traversal. FP32 decoded weights and dot products stay strict.
#ifndef LANES
#define LANES 64
#endif
#ifndef U
#define U 4
#endif
#if FORMAT==0
#undef LANES
#define LANES 256
#endif
#ifndef ALIGNED_WORDS
#if defined(ALIGN_Q41_Q5) && (FORMAT==3 || FORMAT==13)
#define ALIGNED_WORDS 1
#else
#define ALIGNED_WORDS 0
#endif
#endif
layout(local_size_x=LANES) in;
layout(set=0,binding=0,std430) readonly buffer W { uint weights[]; };
layout(set=0,binding=1,std430) readonly buffer X { float input_values[]; };
layout(set=0,binding=2,std430) writeonly buffer Y { float output_values[]; };
layout(push_constant) uniform Params {
    uint columns, rows, row_bytes, weight_offset, input_offset, output_offset, groups_x;
} p;
#ifndef NR
#define NR 2
#endif
shared float partials[NR*LANES];

// A packed row may start on either half of a uint32. Extract four logical
// bytes from their containing words; the buffer's required 4-byte padding
// keeps the containing-word reads in bounds, including the last packed row.
uint word_at(uint b) {
#if ALIGNED_WORDS
    // Host selects this module only for Q4_1/Q5_K with a 4-byte-aligned view.
    return weights[b>>2];
#else
    uint lo=weights[b>>2];
    if ((b&2)==0) return lo;
    return (lo>>16)|(weights[(b>>2)+1]<<16);
#endif
}
float half_at(uint b) { return unpackHalf2x16(weights[b>>2]>>(8*(b&2))).x; }
vec4 input4(uint c) { return vec4(input_values[c],input_values[c+1],input_values[c+2],input_values[c+3]); }
vec4 coeff4(uint w, uint mask, uint bias) {
    return vec4(ivec4(uvec4(w,w>>8,w>>16,w>>24)&mask)-int(bias));
}
// Unsigned bytes of a word as exact FP32 values (0..255).
vec4 ubytes(uint w) { return vec4(float(w&255u),float((w>>8)&255u),float((w>>16)&255u),float(w>>24)); }
vec4 accum(vec4 sum, vec4 w, vec4 x) {
    precise vec4 product=w*x;
    precise vec4 added=sum+product;
    return added;
}
void main() {
    uint lane=gl_LocalInvocationID.x;
#if FORMAT==2 || FORMAT==3
    const uint R=NR;
#else
    const uint R=1;
#endif
    uint row0=(gl_WorkGroupID.y*p.groups_x+gl_WorkGroupID.x)*R;
    if (row0>=p.rows) return; // Uniform across the entire workgroup, including barriers.
    uint row=row0;
    uint row_start=p.weight_offset+row*p.row_bytes;
    vec4 a=vec4(0),z=vec4(0);
#if FORMAT==2 || FORMAT==3
    vec4 ta[NR],tz[NR];
    [[unroll]] for (uint r=0;r<NR;r++) { ta[r]=vec4(0); tz[r]=vec4(0); }
#endif
#if FORMAT==0
    for (uint c=lane*4;c<p.columns;c+=LANES*4) {
        vec4 w=vec4(0),x=vec4(0);
        [[unroll]] for (uint i=0;i<4;i++) {
            if (c+i<p.columns) {
                w[i]=uintBitsToFloat(weights[(row_start>>2)+c+i]);
                x[i]=input_values[p.input_offset+c+i];
            }
        }
        a=accum(a,w,x);
    }
#elif FORMAT==2 || FORMAT==3
    // NR rows share each activation load; per-row accumulation order unchanged.
    uint nblocks=p.columns/32,step=LANES/4,block=lane/4,j=(lane%4)*4;
    for (;block<nblocks;block+=step) {
        vec4 x0=input4(p.input_offset+block*32+j),x1=input4(p.input_offset+block*32+j+16);
        uint q[NR]; float d[NR],mn[NR];
        [[unroll]] for (uint r=0;r<NR;r++) {
            uint b=p.weight_offset+min(row0+r,p.rows-1)*p.row_bytes+block*BLOCK_BYTES;
            q[r]=word_at(b+PAYLOAD_OFFSET+j);
            d[r]=half_at(b);
#if FORMAT==3
            mn[r]=half_at(b+2);
#endif
        }
        [[unroll]] for (uint r=0;r<NR;r++) {
            vec4 lo=ubytes(q[r]&0x0f0f0f0fu),hi=ubytes((q[r]>>4)&0x0f0f0f0fu);
#if FORMAT==2
            float nd=-8.0*d[r];
            vec4 w0=fma(vec4(d[r]),lo,vec4(nd)),w1=fma(vec4(d[r]),hi,vec4(nd));
#else
            vec4 w0=fma(vec4(d[r]),lo,vec4(mn[r])),w1=fma(vec4(d[r]),hi,vec4(mn[r]));
#endif
            ta[r]=accum(ta[r],w0,x0);
            tz[r]=accum(tz[r],w1,x1);
        }
    }
#elif FORMAT==13 || FORMAT==14
    // Eight lanes per 256-value block; four adjacent columns in each of eight groups.
    for (uint block=lane/8;block<p.columns/256;block+=LANES/8) {
        uint b=row_start+block*BLOCK_BYTES,j=(lane%8)*4;
#if FORMAT==13
        vec2 globals=unpackHalf2x16(word_at(b));
        uint sa=word_at(b+4),sb=word_at(b+8),sc=word_at(b+12);
        uint high=word_at(b+16+j);
        [[unroll]] for (uint g=0;g<8;g++) {
            uint shift=(g%4)*8;
            uint scale=(sa>>shift)&63,minimum=(sb>>shift)&63;
            if (g>=4) {
                scale=((sc>>shift)&15)|(((sa>>(shift+6))&3)<<4);
                minimum=((sc>>(shift+4))&15)|(((sb>>(shift+6))&3)<<4);
            }
            uint q=((word_at(b+48+(g/2)*32+j)>>(4*(g%2)))&0x0f0f0f0f)|(((high>>g)&0x01010101)<<4);
            precise float d=globals.x*float(scale),bias=globals.y*float(minimum);
            vec4 w=fma(vec4(d),ubytes(q),vec4(-bias));
            if (g%2==0) a=accum(a,w,input4(p.input_offset+block*256+g*32+j));
            else z=accum(z,w,input4(p.input_offset+block*256+g*32+j));
        }
#else
        float d=half_at(b+208);
        uvec4 low=uvec4(word_at(b+j),word_at(b+32+j),word_at(b+64+j),word_at(b+96+j));
        uvec2 high=uvec2(word_at(b+128+j),word_at(b+160+j));
        uvec4 scales=uvec4(word_at(b+192),word_at(b+196),word_at(b+200),word_at(b+204));
        [[unroll]] for (uint g=0;g<8;g++) {
            uint q=((low[(g/4)*2+g%2]>>(4*((g%4)/2)))&0x0f0f0f0f)|(((high[g/4]>>(2*(g%4)))&0x03030303)<<4);
            uint s=(scales[g/2]>>(16*(g%2)+8*(j/16)))&255;
            precise float scale=d*float(int(s^128)-128);
            vec4 w=fma(vec4(scale),ubytes(q),vec4(-32.0*scale));
            if (g%2==0) a=accum(a,w,input4(p.input_offset+block*256+g*32+j));
            else z=accum(z,w,input4(p.input_offset+block*256+g*32+j));
        }
#endif
    }
#endif
#if FORMAT==2 || FORMAT==3
    [[unroll]] for (uint r=0;r<NR;r++) {
        precise vec4 v=ta[r]+tz[r];
        precise float sum=(v.x+v.y)+(v.z+v.w);
        partials[r*LANES+lane]=sum;
    }
    barrier();
    for (uint stride=LANES/2;stride>0;stride>>=1) {
        if (lane<stride) {
            [[unroll]] for (uint r=0;r<NR;r++) { precise float value=partials[r*LANES+lane]+partials[r*LANES+lane+stride]; partials[r*LANES+lane]=value; }
        }
        barrier();
    }
    if (lane<NR && row0+lane<p.rows) output_values[p.output_offset+row0+lane]=partials[lane*LANES];
#else
    precise vec4 v=a+z;
    precise float sum=(v.x+v.y)+(v.z+v.w);
    partials[lane]=sum;
    barrier();
    for (uint stride=LANES/2;stride>0;stride>>=1) {
        if (lane<stride) { precise float value=partials[lane]+partials[lane+stride]; partials[lane]=value; }
        barrier();
    }
    if (lane==0) output_values[p.output_offset+row]=partials[0];
#endif
}
