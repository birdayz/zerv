#version 450
// Cooperative-matrix path check (tests/gpu_coopmat.zig): one 16x16x16 f16 x f16 -> f32
// multiply-add, and an element-wise product with a per-row scale matrix loaded with
// stride 0 (column-major), which broadcasts s[i] along each row.
// glslc --target-env=vulkan1.1 -O -fshader-stage=compute coopmat.comp -o coopmat.spv
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64) in; // one wave64 subgroup (every subgroup computes the same tile)
layout(std430, binding = 0) readonly buffer A { float16_t a[]; };   // 16x16 row-major
layout(std430, binding = 1) readonly buffer B { float16_t b[]; };   // 16x16 column-major
layout(std430, binding = 2) readonly buffer S { float s[]; };       // 16 row scales
layout(std430, binding = 3) writeonly buffer P { float product[]; }; // A*B + 1, row-major
layout(std430, binding = 4) writeonly buffer Q { float scaled[]; };  // (A*B + 1) .* s[row]
void main() {
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(1.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> scale;
    coopMatLoad(ma, a, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb, b, 0, 16, gl_CooperativeMatrixLayoutColumnMajor);
    acc = coopMatMulAdd(ma, mb, acc);
    coopMatStore(acc, product, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(scale, s, 0, 0, gl_CooperativeMatrixLayoutColumnMajor);
    acc = acc * scale;
    coopMatStore(acc, scaled, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
