  precise vec4 w6=scale6*coeff4(q6,63,32);
  a=accum4(a,w6,input4(p.input_offset+block*256+192+j));
  uint q7=((lo3>>4)&0x0f0f0f0f)|(((hi1>>6)&0x03030303)<<4);
  precise float scale7=d*float(signed_byte(((scales3>>(16+8*(j/16)))&255)));
  precise vec4 w7=scale7*coeff4(q7,63,32);
  z=accum4(z,w7,input4(p.input_offset+block*256+224+j));
#endif
 }
#endif
 }
 precise vec4 v=a+z;
 precise float sum=(v.x+v.y)+(v.z+v.w);
 partials[tid]=sum;
 barrier();
 for(uint stride=LANES/2;stride>0;stride>>=1) {
  if(lane<stride) { precise float value=partials[tid]+partials[tid+stride]; partials[tid]=value; }
  barrier();
 }
 if(lane==0 && row<p.rows) output_values[p.output_offset+row]=partials[tid];
}
