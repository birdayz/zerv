  for(uint k=0;k<4 && c+k<p.columns;k++) a[k]=accum(a[k],uintBitsToFloat(weights[(row_start>>2)+c+k]),input_values[p.input_offset+c+k]);
 }
#elif FORMAT==2 || FORMAT==3
