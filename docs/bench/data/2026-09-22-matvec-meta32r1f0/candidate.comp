  precise vec4 w4=scale4*coeff4(q4,63,32);
  a=accum4(a,w4,input4(p.input_offset+block*256+128+j));
  uint q5=((lo3>>0)&0x0f0f0f0f)|(((hi1>>2)&0x03030303)<<4);
  precise float scale5=d*float(signed_byte(((scales2>>(16+8*(j/16)))&255)));
  precise vec4 w5=scale5*coeff4(q5,63,32);
  z=accum4(z,w5,input4(p.input_offset+block*256+160+j));
  uint q6=((lo2>>4)&0x0f0f0f0f)|(((hi1>>4)&0x03030303)<<4);
