# libdrm 2.4.133 (the version Mesa 26.2.3's wrap pins, same sha256), built by Mesa's meson as
# its subproject (bazel/third_party/mesa.BUILD).
package(default_visibility = ["//visibility:public"])

exports_files([
    "data/amdgpu.ids",
    "meson.build",
])

filegroup(
    name = "all",
    srcs = glob(["**"]),
)
