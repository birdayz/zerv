load("@rules_zig//zig:defs.bzl", "zig_library")
load("//bazel:shaders.bzl", "spirv_modules")

zig_library(
    name = "matvec",
    main = "root.zig",
    extra_srcs = glob(["shaders/**/*.spv"]),
    deps = ["//src/gpu"],
    visibility = ["//visibility:public"],
)

# Read at run time by the GPU tests (tests/matvec_gpu.zig).
exports_files(["shaders/f32_small.spv"], visibility = ["//tests:__pkg__"])

exports_files(glob(["*.comp"]), visibility = ["//tests:__pkg__"])

filegroup(
    name = "shaders",
    srcs = glob(["shaders/**"]),
    visibility = ["//tests:__pkg__"],
)

# The GLSL sources (tools/compile_matvec.py compiles them).
filegroup(
    name = "glsl",
    srcs = glob(["*.comp"]),
    visibility = ["//tools:__pkg__"],
)

# shaders/ regenerated by Bazel; generated_shaders_test: the committed files are exactly that.
# After a change of the sources, tools or variant table: bazel run //src/matvec:update_shaders
spirv_modules(
    name = "generated_shaders",
    compiler = "//tools:compile_matvec",
    committed_dir = "shaders",
    committed = glob(["shaders/**"]),
)

# Every Zig source of this package (the format check, //:zig_fmt).
filegroup(
    name = "zig_srcs",
    srcs = glob(["*.zig"]),
    visibility = ["//:__pkg__", "//tests:__pkg__"],
)

exports_files(["BUILD.bazel"], visibility = ["//tests:__pkg__"])
