load("@rules_zig//zig:defs.bzl", "zig_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel:native.bzl", "native_code")
load("//bazel:shaders.bzl", "spirv_modules")

zig_library(
    name = "model",
    main = "root.zig",
    srcs = glob(["*.zig"], exclude = ["root.zig"]),
    extra_srcs = glob([
        "shaders/*.spv",
        "native/**/*.bin",
        "native/**/*.global",
        "native/**/*.key",
    ]),
    deps = ["//src/artifact", "//src/gpu", "//src/matvec"],
    visibility = ["//visibility:public"],
)

# Shader sources and the compiled-module manifest (tests/test_model.py checks their hashes).
exports_files(glob(["*.comp", "shaders/manifest.json"]), visibility = ["//tests:__pkg__"])

filegroup(
    name = "shaders",
    srcs = glob(["shaders/*"]),
    visibility = ["//tests:__pkg__"],
)

# The GLSL sources (tools/compile_model.py compiles them).
filegroup(
    name = "glsl",
    srcs = glob(["*.comp"]),
    visibility = ["//tools:__pkg__"],
)

# shaders/ regenerated by Bazel; generated_shaders_test: the committed files are exactly that.
# After a change of the sources, tools or variant table: bazel run //src/model:update_shaders
spirv_modules(
    name = "generated_shaders",
    compiler = "//tools:compile_model",
    committed_dir = "shaders",
    committed = glob(["shaders/**"]),
)

# The native gemm_f16x code regenerated and assembled by Bazel (bazel/native.bzl);
# native_code_test: the committed assembly and pipeline binary are exactly that, for each
# driver build a binary is carried for (docs/specs/prefill.md, "One binary per driver build":
# native/ the host's Mesa, native/test_radv/ the test-only GPU runtime's). A change needs the
# GPU: tools/build_native_gemm.py --runtime host|test (driver capture and bitwise sweep).
[
    (
        native_code(
            name = name,
            kernel = "gemm_f16x_q4_0",
            template = directory + "/gemm_f16x_q4_0.bin",
            generator = "//bench/isa_lab:gen_f16x",
            isa_tool = "//bench/isa_lab:isa_tool",
        ),
        py_test(
            name = name + "_test",
            srcs = ["//tools:check_generated.py"],
            main = "//tools:check_generated.py",
            args = [
                "src/model/" + name,
                "src/model/" + directory,
                "--subset",
                "--hint",
                # (args are shell-tokenized)
                "'regenerate with tools/build_native_gemm.py --runtime %s (needs the GPU; docs/development.md)'" % runtime,
            ],
            data = [":" + name] + glob([directory + "/*"]),
            size = "small",
        ),
    )
    for name, directory, runtime in [
        ("native_code", "native", "host"),
        ("native_code_test_radv", "native/test_radv", "test"),
    ]
]

# Every Zig source of this package (the format check, //:zig_fmt).
filegroup(
    name = "zig_srcs",
    srcs = glob(["*.zig"]),
    visibility = ["//:__pkg__", "//tests:__pkg__"],
)

exports_files(["BUILD.bazel"], visibility = ["//tests:__pkg__"])
