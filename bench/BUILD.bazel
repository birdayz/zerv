load("@rules_zig//zig:defs.bzl", "zig_binary")
load("//bazel:defs.bzl", "native_cpu_binary", "zerv_vk_binary")

# Executables are visible to the tests (//tests:test_linkage checks how they link).
package(default_visibility = ["//tests:__pkg__"])

# Component benchmarks and model checks. Measure with `bazel build -c opt` (ReleaseFast).

zig_binary(
    name = "zerv-archive-bench",
    main = "archive.zig",
    deps = ["//src/session", "//src/storage"],
)

zig_binary(
    name = "zerv-preparation-bench",
    main = "preparation.zig",
    deps = ["//src/model"],
)

zig_binary(
    name = "zerv-pressure-bench",
    main = "pressure.zig",
    deps = ["//src/session"],
)

zig_binary(
    name = "zerv-cache-sources-bench",
    main = "cache_sources.zig",
    deps = ["//src/session"],
)

zig_binary(
    name = "zerv-residency-bench",
    main = "residency.zig",
    deps = ["//src/session"],
)

zig_binary(
    name = "zerv-storage-bench",
    main = "storage.zig",
    deps = ["//src/storage"],
)

# The serving competitor llama-server (Vulkan), built in the graph from the pinned llama.cpp
# and ggml and compiled for this CPU like zerv's release build (docs/specs/hermetic-build.md,
# phase 5; the A/B against the host package: docs/bench/2026-09-26-bazel-build.md).
native_cpu_binary(
    name = "llama-server",
    binary = "@llama_cpp//:llama-server",
    tags = ["manual"],
)

