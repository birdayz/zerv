# Python harnesses (tests/test_*.py load them).
exports_files(glob(["*.py", "workloads/*.json"]), visibility = ["//tests:__pkg__"])

# Every Python script (//tests:test_build_lists checks how they build).
filegroup(
    name = "py_srcs",
    srcs = glob(["*.py", "gemm_lab/*.py"]),
    visibility = ["//tests:__pkg__"],
)

# Every Zig source of this package (the format check, //:zig_fmt).
filegroup(
    name = "zig_srcs",
    srcs = glob(["*.zig"]),
    visibility = ["//:__pkg__"],
)

# Read by //tests:test_build_lists.
exports_files(["BUILD.bazel"], visibility = ["//tests:__pkg__"])

zerv_vk_binary(
