#version 450
// Lab variant of src/model/gemm_f16d.comp (block 18e decode v2): same arithmetic, coalesced
// weight loads. The wave's 16 rows x 8 Q4_0 blocks (16 x 144 bytes; 16-byte aligned since
// a_base, a_rs % 16 == 0 and k_chunk, K % 256 == 0) are loaded as 144 contiguous 16-byte
// pieces (lane i: pieces i + 32 j), one iteration ahead in registers, stored to a
// wave-private LDS slice; each lane then reads its row's blocks from LDS (subgroup barrier
// only). MT 16-row tiles per wave share the B fragment; WAVES * 16 * MT = 64.
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#ifndef MT
#define MT 1
#endif
#define WAVES (4/MT)
#define PIECES (144u*MT)
#define PER ((PIECES+31u)/32u)
layout(local_size_x=WAVES*32) in;
layout(set=0,binding=0,std430) readonly buffer A4 { uvec4 aw4[]; };
layout(set=0,binding=1,std430) buffer Act { float act[]; };
layout(set=0,binding=2,std430) readonly buffer Io { uint io[]; };
layout(set=0,binding=3,std430) readonly restrict buffer ActX { vec4 xin4[]; };
layout(push_constant) uniform P {
    uint a_base, a_rs, a_cs, a_bs, a_group;
    uint x_base, x_rs, x_bs;
    uint y_base, y_rs, y_bs;
    uint m, k;
    uint flags;
    uint k_chunk;
} p;
#define IO_COUNT 2
shared uvec4 slice[WAVES][PIECES];

uint lword(uint wave, uint w) { return slice[wave][w>>2u][w&3u]; }

void main() {
    uint lane=gl_SubgroupInvocationID, wave=gl_SubgroupID;
    uint n=io[IO_COUNT];
    uint m0=(gl_WorkGroupID.x*WAVES+wave)*16u*MT, t0=gl_WorkGroupID.y*16u;
    if (t0>=n) return; // uniform per workgroup
#if DIAG==9
    return;
#endif
    uint tok=min(t0+lane%16u,n-1u);
    uint kb=gl_WorkGroupID.z*p.k_chunk, ke=p.k_chunk!=0u ? min(p.k,kb+p.k_chunk) : p.k;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[MT];
    [[unroll]] for (uint mt=0u;mt<MT;mt++) acc[mt]=coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    uint xrow=(p.x_base+tok*p.x_rs)/4u;
    // Piece c = lane + 32 j: row c / 9 (0 .. 16 MT - 1), 16-byte piece c % 9 of its 144 bytes.
    uint src[PER];
    [[unroll]] for (uint j=0u;j<PER;j++) {
        uint c=min(lane+32u*j,PIECES-1u);
        src[j]=(p.a_base+(m0+c/9u)*p.a_rs)/16u+c%9u;
    }
    uvec4 nxt[PER];
    [[unroll]] for (uint j=0u;j<PER;j++) nxt[j]=aw4[src[j]+(kb/32u)*18u/16u];
    for (uint k0=kb;k0<ke;k0+=256u) {
        subgroupMemoryBarrierShared(); subgroupBarrier(); // previous readers done
        [[unroll]] for (uint j=0u;j<PER;j++) if (lane+32u*j<PIECES) slice[wave][lane+32u*j]=nxt[j];
        subgroupMemoryBarrierShared(); subgroupBarrier();
        if (k0+256u<ke) [[unroll]] for (uint j=0u;j<PER;j++) nxt[j]=aw4[src[j]+((k0+256u)/32u)*18u/16u];
        [[unroll]] for (uint u=0u;u<8u;u++) {
            uint xk=xrow+(k0+32u*u)/4u;
            [[unroll]] for (uint h=0u;h<2u;h++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> fb;
#if DIAG==1
                fb=coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>(float16_t(1.0));
#else
                [[unroll]] for (uint c=0u;c<4u;c++) {
                    vec4 xv=xin4[xk+4u*h+c];
                    fb[4u*c]=float16_t(xv.x); fb[4u*c+1u]=float16_t(xv.y); fb[4u*c+2u]=float16_t(xv.z); fb[4u*c+3u]=float16_t(xv.w);
                }
#endif
                [[unroll]] for (uint mt=0u;mt<MT;mt++) {
                    // Block u of row mt*16 + lane%16: bytes (row*144 + 18u) in the slice.
                    uint b=(mt*16u+lane%16u)*144u+u*18u, wb=b>>2u;
                    bool o=(b&2u)!=0u;
                    uint w0=lword(wave,wb), w1=lword(wave,wb+1u), w2=lword(wave,wb+2u), w3=lword(wave,wb+3u), w4=lword(wave,wb+4u);
                    f16vec2 d=f16vec2(float16_t(unpackHalf2x16(o ? w0>>16u : w0).x));
                    uint qw[4]=uint[4](o ? w1 : (w0>>16u)|(w1<<16u), o ? w2 : (w1>>16u)|(w2<<16u),
                                       o ? w3 : (w2>>16u)|(w3<<16u), o ? w4 : (w3>>16u)|(w4<<16u));
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> fa;
#if DIAG==2
                    fa=coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>(float16_t(uintBitsToFloat(w0^w3)));
#else
                    [[unroll]] for (uint q=0u;q<4u;q++) {
                        uint x=(qw[q]>>(4u*h))&0x0F0F0F0Fu;
                        uint p01=(x&0xFFu)|((x<<8u)&0xFF0000u), p23=((x>>16u)&0xFFu)|((x>>8u)&0xFF0000u);
                        f16vec2 v01=(unpackFloat2x16(p01|0x64006400u)-f16vec2(float16_t(1032.0)))*d;
                        f16vec2 v23=(unpackFloat2x16(p23|0x64006400u)-f16vec2(float16_t(1032.0)))*d;
                        fa[4u*q]=v01.x; fa[4u*q+1u]=v01.y; fa[4u*q+2u]=v23.x; fa[4u*q+3u]=v23.y;
                    }
#endif
#if DIAG==3
                    acc[mt]=acc[mt]+coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float(fa[0])*float(fb[0]));
#else
                    acc[mt]=coopMatMulAdd(fa, fb, acc[mt]);
#endif
                }
            }
        }
    }
    [[unroll]] for (uint mt=0u;mt<MT;mt++)
        coopMatStore(acc[mt], act, p.y_base+gl_WorkGroupID.z*p.y_bs+t0*p.y_rs+m0+mt*16u, p.y_rs, gl_CooperativeMatrixLayoutColumnMajor);
}
